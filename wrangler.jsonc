{
  "name": "think-trace-repro",
  "main": "src/server.ts",
  "compatibility_date": "2026-09-26",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/agents/*", "/api/*"]
  },
  "durable_objects": { "bindings": [{ "name": "ReproAgent", "class_name": "ReproAgent" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ReproAgent"] }],
  "observability": { "enabled": true, "traces": { "enabled": true, "head_sampling_rate": 1 } }
}
